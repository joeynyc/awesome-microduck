{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/joeynyc/awesome-microduck/main/revocations.schema.json",
  "title": "awesome-microduck policy revocations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "entries": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revoked_at", "reason"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(huggingface|github):[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "revoked_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
          "replacement": {
            "type": "string",
            "pattern": "^(huggingface|github):[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "advisory_url": { "type": "string", "pattern": "^https://" }
        }
      }
    }
  }
}
